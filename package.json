{
  "name": "ledbox",
  "version": "2.1.73",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy.mjs --best-effort && next build && rm -rf .next/standalone/public .next/standalone/.next/static && cp -R public .next/standalone/public && mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/static",
    "start": "node scripts/migrate-deploy.mjs && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:rules": "node --import tsx --test tests/*.test.ts && node scripts/check-fields.mjs && npm run test:automation",
    "test:automation": "node --test tests/automation.test.mjs",
    "check:fields": "node scripts/check-fields.mjs",
    "release:prepare": "npm run typecheck && npm run test:rules && npm run build",
    "release:check": "node scripts/orquestador.mjs prepare",
    "release:publish": "node scripts/orquestador.mjs hd",
    "deploy:verificar": "node scripts/verify-release.mjs",
    "deploy:patch": "node scripts/deploy.mjs",
    "pp": "node scripts/orquestador.mjs pp",
    "pd": "node scripts/orquestador.mjs pd",
    "al": "node scripts/orquestador.mjs al",
    "ht": "node scripts/orquestador.mjs ht",
    "hd": "node scripts/orquestador.mjs hd",
    "e2e": "node scripts/e2e-smoke.mjs",
    "auto-hd": "node scripts/orquestador.mjs auto",
    "watch-hd": "node scripts/orquestador.mjs watch"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "15.5.27",
    "owncoding-ui": "github:dariodeoli/owncoding-ui#9dc9ec44216d22e92fad72fc1ad08bf3296a8da2",
    "pdf-lib": "1.17.1",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.2",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
