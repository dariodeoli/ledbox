generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  ADMIN
  FINANCE
  OPERATIONS
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum BillingUnit {
  DAILY
  SQUARE_METER_DAILY
  EVENT
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id               String                   @id
  name             String
  slug             String                   @unique
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  /// Datos de pago de la empresa (issue #14): `{ bank, holder, ruc, account, alias }`.
  /// Solo OWNER/ADMIN los configuran y la API pública los entrega con el presupuesto aprobado.
  paymentDetails   Json?
  memberships      OrganizationMembership[]
  adminMemberships AdminMembership[]
  adminSessions    AdminSession[]
  leads            Lead[]
  quotes           QuoteRequest[]
  clients          Client[]
  events           Event[]
  budgets          Budget[]
  changeRequests   BudgetChangeRequest[]
  clientPayments   ClientPayment[]
  paymentProofs    BudgetPaymentProof[]
  suppliers        Supplier[]
  supplierJobs     SupplierJob[]
  inventoryItems   InventoryItem[]
  promoters        Promoter[]
  auditLogs        AuditLog[]

  @@index([active, createdAt])
}

model AppUser {
  id           String                   @id
  name         String
  email        String                   @unique
  passwordHash String?
  googleSub    String?                  @unique
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships  OrganizationMembership[]
  sessions     AppSession[]

  @@index([active, createdAt])
}

model OrganizationMembership {
  id             String           @id
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
}

model AppSession {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AdminUser {
  id                  String               @id
  name                String
  email               String               @unique
  passwordHash        String
  role                AdminRole            @default(ADMIN)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            AdminSession[]
  memberships         AdminMembership[]
  passwordResetTokens PasswordResetToken[]
}

/// Membresía de un usuario del panel a una empresa (organización).
/// El rol efectivo para permisos es el de la membresía; `AdminUser.role`
/// queda como rol global de la cuenta y se copia acá al crear la membresía.
model AdminMembership {
  id             String       @id
  adminUserId    String
  organizationId String
  role           AdminRole    @default(VIEWER)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, organizationId])
  @@index([organizationId, active])
}

model AdminSession {
  id                   String        @id
  userId               String
  activeOrganizationId String?
  jtiHash              String        @unique
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime      @default(now())
  user                 AdminUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([activeOrganizationId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Lead {
  id            String     @id
  name          String
  phone         String
  email         String
  company       String?
  ruc           String?
  reason        String?
  eventDate     DateTime?
  location      String?
  message       String?
  /**
   * Notas internas del equipo comercial (no las escribe el sitio público).
   */
  internalNotes String?
  source        String     @default("website")
  consentAt     DateTime
  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  quoteRequests  QuoteRequest[]
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([organizationId, createdAt])
}

model QuoteRequest {
  id             String        @id
  leadId         String?
  referenceTotal Int?
  currency       String        @default("PYG")
  durationDays   Int?
  eventDate      DateTime?
  location       String?
  source         String        @default("website")
  createdAt      DateTime      @default(now())
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
}

model QuoteItem {
  id             String       @id
  quoteRequestId String
  productSlug    String
  productName    String
  quantity       Int
  duration       Int?
  billingUnit    BillingUnit
  unitPrice      Int?
  subtotal       Int?
  notes          String?
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

model RateLimitBucket {
  id          String   @id
  key         String   @unique
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

enum ClientType {
  FINAL
  RESELLER
}

enum EventStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommercialStatus {
  DRAFT
  SENT
  NEGOTIATING
  APPROVED
  LOST
  CANCELLED
}

/// Motivo de una solicitud del cliente desde el portal (issue #14).
/// `changes` es el pedido de cambios libre del issue #12 y comparte el mismo
/// circuito de resolución (aceptar o rechazar con nota) que ítems y rebaja.
enum BudgetChangeKind {
  items
  discount
  changes
}

/// Ciclo de vida de una solicitud del portal: pendiente → aceptada o rechazada.
enum BudgetChangeStatus {
  pending
  accepted
  rejected
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

/**
 * Estado de un cobro de cliente (issue #16): a cobrar (`PENDING`), cobrado
 * (`RECEIVED`) o anulado (`CANCELLED`). Los cobros históricos quedan `RECEIVED`.
 */
enum ClientPaymentStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum SupplierCategory {
  CARPENTRY
  GRAPHICS
  ELECTRICITY
  TRANSPORT
  FURNITURE
  AUDIOVISUAL
  STAFF
  OTHER
}

enum SupplierWorkStatus {
  PENDING
  CONTRACTED
  ADVANCE_PENDING
  ADVANCE_PAID
  IN_PRODUCTION
  DELIVERED
  BALANCE_PENDING
  PAID
  CANCELLED
}

enum InventoryKind {
  REUSABLE
  CONSUMABLE
  DISPOSABLE
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
  RETIRED
}

enum EventTaskType {
  SETUP
  EVENT
  STRIKE
  PAYMENT
  COLLECTION
}

model Client {
  id             String          @id
  organizationId String
  type           ClientType      @default(FINAL)
  name           String
  company        String?
  ruc            String?
  email          String?
  phone          String?
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         Event[]
  budgets        Budget[]
  payments       ClientPayment[]

  @@index([type, active])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model Event {
  id             String           @id
  organizationId String
  clientId       String
  name           String
  location       String?
  setupAt        DateTime?
  startsAt       DateTime?
  endsAt         DateTime?
  strikeAt       DateTime?
  status         EventStatus      @default(DRAFT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  budgets        Budget[]
  assignments    EventInventory[]
  tasks          EventTask[]
  supplierJobs   SupplierJob[]

  @@index([startsAt, status])
  @@index([clientId, createdAt])
  @@index([organizationId, startsAt])
}

model Budget {
  id                   String                @id
  organizationId       String
  clientId             String
  eventId              String?
  title                String
  status               CommercialStatus      @default(DRAFT)
  subtotal             Int                   @default(0)
  discount             Int                   @default(0)
  total                Int                   @default(0)
  costEstimate         Int                   @default(0)
  validUntil           DateTime?
  notes                String?
  // Plan de pagos (issue #14): anticipo y cuotas visibles en el portal.
  // `installmentsJson` guarda `[{ label, amount, dueAt }]` (dueAt `YYYY-MM-DD`).
  advanceAmount        Int                   @default(0)
  paymentTerms         String?
  installmentsJson     Json?
  // Portal del cliente (issue #12): token público del presupuesto y evidencia
  // de la aprobación digital o manual. El token es la única credencial del
  // link y se puede regenerar o revocar desde el panel.
  publicToken          String?               @unique
  publicTokenCreatedAt DateTime?
  approvedAt           DateTime?
  approvedByName       String?
  approvalMethod       String?
  approvalIp           String?
  approvalUserAgent    String?
  approvalNote         String?
  revisionRequestedAt  DateTime?
  revisionNote         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client               Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event                Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  items                BudgetItem[]
  payments             ClientPayment[]
  changeRequests       BudgetChangeRequest[]
  paymentProofs        BudgetPaymentProof[]

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

model BudgetItem {
  id        String  @id
  budgetId  String
  name      String
  quantity  Int     @default(1)
  days      Int     @default(1)
  unitPrice Int
  costPrice Int     @default(0)
  subtotal  Int
  notes     String?
  budget    Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

/// Solicitud del cliente desde el portal (issue #14): propuesta de ítems,
/// pedido de rebaja o pedido de cambios (issue #12). El cliente solo ajusta
/// cantidades y días —los precios unitarios son fijos— o propone un descuento;
/// el equipo la acepta (aplicándola al presupuesto) o la rechaza con una nota.
/// `payload` (forma documentada):
///   kind `items`:    `{ items: [{ id, name, quantity, days }] }`
///   kind `discount`: `{ discount: { type: "percent" | "amount", value, amount } }`
///   kind `changes`:  `{ comment: string }`
model BudgetChangeRequest {
  id               String             @id
  organizationId   String
  budgetId         String
  kind             BudgetChangeKind
  status           BudgetChangeStatus @default(pending)
  payload          Json
  note             String?
  requestedByName  String
  requestedByEmail String?
  createdAt        DateTime           @default(now())
  resolvedAt       DateTime?
  resolvedByName   String?
  responseNote     String?
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget           Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([budgetId, createdAt])
}

/**
 * Cobro de cliente: cobrado al momento o a plazo (issue #16).
 *
 * - `status`: `PENDING` (a cobrar), `RECEIVED` (cobrado) o `CANCELLED` (anulado).
 * - `paidAt`: fecha de pago; `null` mientras el cobro está pendiente (un cobro a
 *   plazo no es plata cobrada hasta que se marca).
 * - `collectedAt`: fecha real del cobro (los registros viejos usan `paidAt`).
 * - `invoiceIssuedAt`/`invoiceNumber`: factura emitida; `dueAt` es el vencimiento
 *   de cobro (la emisión a 30 días se calcula: emisión + días).
 * - `chequeDate`: fecha del cheque cuando el método es cheque.
 */
model ClientPayment {
  id              String              @id
  organizationId  String
  clientId        String
  budgetId        String?
  amount          Int
  status          ClientPaymentStatus @default(RECEIVED)
  paidAt          DateTime?
  collectedAt     DateTime?
  method          String?
  reference       String?
  invoiceNumber   String?
  invoiceIssuedAt DateTime?
  dueAt           DateTime?
  chequeDate      DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  budget          Budget?             @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  proofs          BudgetPaymentProof[]

  @@index([clientId, paidAt])
  @@index([organizationId, paidAt])
  @@index([organizationId, status, dueAt])
}

/**
 * Comprobante de pago subido por el cliente desde el portal (issue #17).
 *
 * El binario vive en `data` (bytea): nunca es público — se sirve únicamente con
 * sesión del panel (`/api/admin/budgets/proofs/[id]`) — y `mime`/`size` guardan
 * el tipo real detectado por magic bytes y el tamaño ya comprimido. El
 * comprobante se cuelga del presupuesto y, cuando hay un único cobro a plazo
 * pendiente, también de ese cobro (`paymentId`); sin cobro queda a nivel del
 * presupuesto para que el equipo lo resuelva al marcar cobrado.
 */
model BudgetPaymentProof {
  id             String         @id
  organizationId String
  budgetId       String
  paymentId      String?
  uploadedByName String
  mime           String
  size           Int
  data           Bytes
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget         Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  payment        ClientPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId, budgetId, createdAt])
  @@index([paymentId])
}

model Supplier {
  id             String           @id
  organizationId String
  name           String
  company        String?
  phone          String?
  email          String?
  category       SupplierCategory @default(OTHER)
  paymentTerms   String?
  notes          String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs           SupplierJob[]

  @@index([category, active])
  @@index([organizationId, name])
}

model SupplierJob {
  id             String             @id
  organizationId String
  supplierId     String
  eventId        String?
  category       SupplierCategory   @default(OTHER)
  description    String
  total          Int
  advance        Int                @default(0)
  status         SupplierWorkStatus @default(PENDING)
  dueAt          DateTime?
  deliveredAt    DateTime?
  paidAt         DateTime?
  paymentMethod  String?
  receipt        String?
  notes          String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([eventId])
  @@index([organizationId, dueAt])
}

model InventoryItem {
  id              String           @id
  organizationId  String
  name            String
  category        String
  sku             String?
  kind            InventoryKind    @default(REUSABLE)
  status          InventoryStatus  @default(AVAILABLE)
  quantity        Int              @default(1)
  replacementCost Int              @default(0)
  dailyCost       Int              @default(0)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments     EventInventory[]

  @@unique([organizationId, sku])
  @@index([status, category])
  @@index([organizationId, name])
}

model EventInventory {
  id              String        @id
  eventId         String
  inventoryId     String
  quantity        Int           @default(1)
  /// Rango en el que el equipo queda comprometido con el evento. Si falta, se
  /// usa el rango del evento (montaje → desmontaje) para calcular disponibilidad.
  startsAt        DateTime?
  endsAt          DateTime?
  checkedOut      Boolean       @default(false)
  checkedIn       Boolean       @default(false)
  checkedOutAt    DateTime?
  checkedInAt     DateTime?
  conditionOut    String?
  conditionIn     String?
  /// Unidades que volvieron dañadas y unidades que no volvieron, con su detalle.
  damagedQuantity Int           @default(0)
  missingQuantity Int           @default(0)
  damageNotes     String?
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, inventoryId])
  @@index([inventoryId, startsAt, endsAt])
}

model Promoter {
  id             String       @id
  organizationId String
  name           String
  phone          String?
  email          String?
  photoUrl       String?
  specialties    String?
  active         Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          EventTask[]

  @@index([active, name])
  @@index([organizationId, name])
}

model EventTask {
  id          String        @id
  eventId     String
  promoterId  String?
  type        EventTaskType
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  notes       String?
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoter    Promoter?     @relation(fields: [promoterId], references: [id], onDelete: SetNull)

  @@index([dueAt, completedAt])
}

/// Historial de cambios del panel: quién hizo qué sobre cada registro y con qué
/// valores. El actor se guarda denormalizado (id + nombre + correo) para que la
/// traza sobreviva a renombres o bajas de cuentas; `detail` guarda solo los
/// campos tocados (`changes` con antes/después, `fields` en altas, `before` en bajas).
model AuditLog {
  id             String       @id
  organizationId String
  actorId        String
  actorName      String
  actorEmail     String
  action         String
  entity         String
  entityId       String
  summary        String
  detail         Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([organizationId, actorId])
}
