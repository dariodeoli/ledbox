generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  ADMIN
  FINANCE
  OPERATIONS
  VIEWER
}

/**
 * Ciclo de vida de una invitación al equipo (issue #31): `pending` es la única
 * vigente; `accepted` cuando la persona la aceptó, `revoked` si el equipo la
 * cortó y `expired` cuando pasó el vencimiento. Reenviar reusa la fila y vuelve
 * a `pending`.
 */
enum TeamInvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum BillingUnit {
  DAILY
  SQUARE_METER_DAILY
  EVENT
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Plan comercial vendible (issue #42): límites y precio mensual en guaraníes.
///
/// - `maxUsers` cuenta **membresías activas + invitaciones pendientes**: invitar
///   reserva un lugar, así el tope no se rompe al aceptar una invitación vieja.
/// - `maxEventsPerMonth` cuenta los eventos **creados** en el mes calendario de
///   Asunción; los eventos ya cargados nunca se ocultan.
/// - `null` en un límite significa sin tope. `priceMonthly` es Int PYG: la UI
///   dibuja el formato.
///
/// El catálogo lo publica la migración `202609220027_plans_catalog` (misma lista
/// que `PLAN_CATALOG` en `lib/plan-rules.ts` y el seed: si cambia, van las tres).
model Plan {
  id                String              @id
  code              String              @unique
  name              String
  description       String?
  maxUsers          Int?
  maxEventsPerMonth Int?
  priceMonthly      Int
  /// Capacidades incluidas que dibuja la comparación (lista de textos).
  features          Json?
  /// Orden de exhibición en el catálogo (menor primero).
  sortOrder         Int                 @default(0)
  /// Plan vigente para nuevas asignaciones; los retirados se conservan.
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organizations     Organization[]
  changeRequests    PlanChangeRequest[]

  @@index([active, sortOrder])
}

/// Estado de la solicitud de cambio de plan: nace `pending` (la registra el
/// equipo desde el panel) y el cambio efectivo lo hace Owncoding —todavía sin
/// pasarela de pago—, que la marca `approved` o `rejected`.
enum PlanChangeRequestStatus {
  pending
  approved
  rejected
  cancelled
}

/// Solicitud de cambio de plan de una empresa (issue #42), auditada con el actor
/// real. Una sola `pending` por empresa: pedir otro plan actualiza la existente.
model PlanChangeRequest {
  id               String                  @id
  organizationId   String
  /// Plan solicitado: el vigente no cambia hasta que Owncoding lo aplique.
  planId           String
  status           PlanChangeRequestStatus @default(pending)
  note             String?
  requestedById    String?
  requestedByName  String
  requestedByEmail String?
  decidedAt        DateTime?
  decidedByName    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([planId])
}

model Organization {
  id                String                   @id
  name              String
  slug              String                   @unique
  active            Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  /// Datos de pago de la empresa (issue #14): `{ bank, holder, ruc, account, alias }`.
  /// Solo OWNER/ADMIN los configuran y la API pública los entrega con el presupuesto aprobado.
  paymentDetails    Json?
  /// Plan comercial vigente (issue #42). `null` = todavía sin asignar: la capa de
  /// tenancy le pone el plan por defecto la primera vez y los límites aplican igual.
  planId            String?
  /// Inicio del plan vigente (lo dibuja la página de Plan).
  planStartedAt     DateTime?
  plan              Plan?                    @relation(fields: [planId], references: [id], onDelete: SetNull)
  planRequests      PlanChangeRequest[]
  memberships       OrganizationMembership[]
  adminMemberships  AdminMembership[]
  adminSessions     AdminSession[]
  logos             OrganizationLogo[]
  leads             Lead[]
  quotes            QuoteRequest[]
  clients           Client[]
  events            Event[]
  budgets           Budget[]
  changeRequests    BudgetChangeRequest[]
  clientPayments    ClientPayment[]
  expectedPayments  ExpectedPayment[]
  paymentReminders  PaymentReminderLog[]
  paymentProofs     BudgetPaymentProof[]
  mailLogs          MailLog[]
  messageTemplates  MessageTemplate[]
  suppliers         Supplier[]
  supplierJobs      SupplierJob[]
  inventoryItems    InventoryItem[]
  promoters         Promoter[]
  auditLogs         AuditLog[]
  treasuryAccounts  TreasuryAccount[]
  treasuryMovements TreasuryMovement[]
  expenses          Expense[]
  idempotencyKeys   IdempotencyKey[]
  teamInvitations   TeamInvitation[]

  @@index([active, createdAt])
  @@index([planId])
}

model AppUser {
  id           String                   @id
  name         String
  email        String                   @unique
  passwordHash String?
  googleSub    String?                  @unique
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships  OrganizationMembership[]
  sessions     AppSession[]

  @@index([active, createdAt])
}

/// Variante del logo de la empresa (issue #22): `light` (para fondos oscuros) y
/// `dark` (para fondos claros). La regla que decide cuál se usa vive en un solo
/// lugar (`components/admin/AdminAvatar.tsx`); en papel siempre va la clara.
enum OrganizationLogoVariant {
  light
  dark
}

model OrganizationMembership {
  id             String           @id
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
}

model AppSession {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AdminUser {
  id                  String               @id
  name                String
  email               String               @unique
  passwordHash        String
  role                AdminRole            @default(ADMIN)
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  /// PIN de desbloqueo del panel (issue #21): hash bcrypt de 4–6 dígitos, nunca
  /// en claro ni en logs. Sin PIN no hay bloqueo rápido (el auto-bloqueo no aplica).
  pinHash             String?
  pinUpdatedAt        DateTime?
  /// Preferencia de auto-bloqueo por inactividad (issue #21), por usuario:
  /// `autoLockEnabled = false` es «nunca» y `autoLockMinutes` la opción elegida.
  autoLockEnabled     Boolean              @default(true)
  autoLockMinutes     Int                  @default(10)
  sessions            AdminSession[]
  memberships         AdminMembership[]
  passwordResetTokens PasswordResetToken[]
  avatar              AdminUserAvatar?
}

/// Membresía de un usuario del panel a una empresa (organización).
/// El rol efectivo para permisos es el de la membresía; `AdminUser.role`
/// queda como rol global de la cuenta y se copia acá al crear la membresía.
model AdminMembership {
  id             String       @id
  adminUserId    String
  organizationId String
  role           AdminRole    @default(VIEWER)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, organizationId])
  @@index([organizationId, active])
}

/// Invitación por correo al equipo de una empresa (issue #31).
///
/// - Una sola fila por correo + empresa (`@@unique([organizationId, email])`):
///   invitar de nuevo **actualiza** la existente (token nuevo, vencimiento
///   extendido y estado `pending`) en lugar de acumular invitaciones.
/// - El token del link es aleatorio y no enumerable (`randomInt` sobre el
///   alfabeto sin caracteres ambiguos, el mismo criterio que el código del
///   portal público) y se guarda solo como hash SHA-256: si se pierde el link,
///   se reenvía (token nuevo) y el viejo muere.
/// - El rol se valida server-side contra los roles asignables: una invitación
///   nunca otorga OWNER.
/// - Quién invitó se guarda denormalizado para que la traza sobreviva a bajas.
model TeamInvitation {
  id             String               @id
  organizationId String
  /// Correo normalizado (minúsculas) del invitado.
  email          String
  role           AdminRole            @default(VIEWER)
  /// SHA-256 del token del link; el token plano solo viaja en el correo.
  tokenHash      String               @unique
  status         TeamInvitationStatus @default(pending)
  invitedById    String?
  invitedByName  String
  invitedByEmail String?
  expiresAt      DateTime
  /// Último intento de envío real del correo (lo dibuja la lista del panel).
  lastSentAt     DateTime?
  /// Intentos de envío registrados para esta fila (alta + reenvíos).
  sentCount      Int                  @default(0)
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedByName String?
  revokedAt      DateTime?
  revokedByName  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, status, expiresAt])
  @@index([email])
}

model AdminSession {
  id                   String        @id
  userId               String
  activeOrganizationId String?
  jtiHash              String        @unique
  expiresAt            DateTime
  revokedAt            DateTime?
  /// Bloqueo rápido del panel (issue #21): instante en que la sesión se bloqueó
  /// (por inactividad o a mano), PIN fallidos seguidos desde ese bloqueo y motivo
  /// (`inactivity`/`manual`) para que la pantalla lo cuente igual tras recargar.
  /// A los 5 fallidos la sesión se revoca y queda exigido el login completo.
  lockedAt             DateTime?
  lockAttempts         Int           @default(0)
  lockReason           String?
  createdAt            DateTime      @default(now())
  user                 AdminUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([activeOrganizationId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Avatar del panel (issue #22): un binario por usuario, en la base igual que
/// los comprobantes de pago. Nunca es público: se sirve solo con sesión desde
/// `/api/admin/users/avatars/[id]`. `width`/`height` guardan el recorte cuadrado
/// que ya hizo el navegador (canvas, sin librerías) para no re-calcularlo.
model AdminUserAvatar {
  id        String    @id
  userId    String    @unique
  mime      String
  size      Int
  width     Int?
  height    Int?
  data      Bytes
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Logo de la empresa por tema (issue #22): una fila por variante (`light` y
/// `dark`). El binario vive en la base y se sirve con sesión desde
/// `/api/admin/organization/branding/logos/[variant]`; en papel siempre se usa
/// la variante clara y sin logo queda el monograma `LB`.
model OrganizationLogo {
  id             String                  @id
  organizationId String
  variant        OrganizationLogoVariant
  mime           String
  size           Int
  width          Int?
  height         Int?
  data           Bytes
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, variant])
}

model Lead {
  id            String     @id
  name          String
  phone         String
  email         String
  company       String?
  ruc           String?
  reason        String?
  eventDate     DateTime?
  location      String?
  message       String?
  /**
   * Notas internas del equipo comercial (no las escribe el sitio público).
   */
  internalNotes String?
  source        String     @default("website")
  consentAt     DateTime
  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  quoteRequests  QuoteRequest[]
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([organizationId, createdAt])
}

model QuoteRequest {
  id             String        @id
  leadId         String?
  referenceTotal Int?
  currency       String        @default("PYG")
  durationDays   Int?
  eventDate      DateTime?
  location       String?
  source         String        @default("website")
  createdAt      DateTime      @default(now())
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
}

model QuoteItem {
  id             String       @id
  quoteRequestId String
  productSlug    String
  productName    String
  quantity       Int
  duration       Int?
  billingUnit    BillingUnit
  unitPrice      Int?
  subtotal       Int?
  notes          String?
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

model RateLimitBucket {
  id          String   @id
  key         String   @unique
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

enum ClientType {
  FINAL
  RESELLER
}

enum EventStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommercialStatus {
  DRAFT
  SENT
  NEGOTIATING
  APPROVED
  LOST
  CANCELLED
}

/// Motivo de una solicitud del cliente desde el portal (issue #14).
/// `changes` es el pedido de cambios libre del issue #12 y comparte el mismo
/// circuito de resolución (aceptar o rechazar con nota) que ítems y rebaja.
enum BudgetChangeKind {
  items
  discount
  changes
}

/// Ciclo de vida de una solicitud del portal: pendiente → aceptada o rechazada.
enum BudgetChangeStatus {
  pending
  accepted
  rejected
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

/**
 * Estado de un cobro de cliente (issue #16): a cobrar (`PENDING`), cobrado
 * (`RECEIVED`) o anulado (`CANCELLED`). Los cobros históricos quedan `RECEIVED`.
 */
enum ClientPaymentStatus {
  PENDING
  RECEIVED
  CANCELLED
}

/**
 * Canal de un recordatorio de cobro al cliente (issue #19): correo (Resend) o
 * WhatsApp (mensaje prellenado que el equipo abre desde el panel).
 */
enum PaymentReminderChannel {
  email
  whatsapp
}

/**
 * Estado de un recordatorio: `sending` mientras viaja, `sent` si el proveedor lo
 * aceptó, `failed` si el envío falló y `opened` cuando el equipo abrió el
 * mensaje de WhatsApp (el envío lo confirma el equipo, no la app).
 */
enum PaymentReminderStatus {
  sending
  sent
  failed
  opened
}

enum SupplierCategory {
  CARPENTRY
  GRAPHICS
  ELECTRICITY
  TRANSPORT
  FURNITURE
  AUDIOVISUAL
  STAFF
  OTHER
}

enum SupplierWorkStatus {
  PENDING
  CONTRACTED
  ADVANCE_PENDING
  ADVANCE_PAID
  IN_PRODUCTION
  DELIVERED
  BALANCE_PENDING
  PAID
  CANCELLED
}

enum InventoryKind {
  REUSABLE
  CONSUMABLE
  DISPOSABLE
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
  RETIRED
}

enum EventTaskType {
  SETUP
  EVENT
  STRIKE
  PAYMENT
  COLLECTION
}

/**
 * Disponibilidad real de una promotora (issue #24): disponible, no disponible
 * (con motivo y, si aplica, hasta cuándo) o a definir. No bloquea la asignación
 * a una tarea: la app avisa con el estado real.
 */
enum PromoterAvailability {
  AVAILABLE
  UNAVAILABLE
  TO_DEFINE
}

model Client {
  id             String          @id
  organizationId String
  type           ClientType      @default(FINAL)
  name           String
  company        String?
  ruc            String?
  email          String?
  phone          String?
  /**
   * Persona encargada del cliente (issue #36): nombre, cargo y contacto
   * directo. Conviven con los datos generales del cliente; si un dato falta no
   * se completa con otro campo.
   */
  contactName    String?
  contactRole    String?
  contactPhone   String?
  contactEmail   String?
  /// Sitio web normalizado (`https://…`); el link se dibuja en la ficha.
  website        String?
  /// Usuario de Instagram sin `@`; el link se arma con `instagramHref`.
  instagram      String?
  /// WhatsApp propio cuando difiere del teléfono general (mismo formato).
  whatsapp       String?
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         Event[]
  budgets        Budget[]
  payments       ClientPayment[]
  logo           ClientLogo?

  @@index([type, active])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

/// Logo del cliente (issue #36): mismo pipeline de imágenes del panel
/// (`lib/server/branding.ts` + `lib/identity-image.ts`), binario en la base y
/// servido solo con sesión desde `/api/admin/clients/[id]/logo`. Un logo por
/// cliente; sin logo queda el monograma de iniciales del avatar.
model ClientLogo {
  id        String   @id
  clientId  String   @unique
  mime      String
  size      Int
  width     Int?
  height    Int?
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Event {
  id             String           @id
  organizationId String
  clientId       String
  name           String
  location       String?
  setupAt        DateTime?
  startsAt       DateTime?
  endsAt         DateTime?
  strikeAt       DateTime?
  status         EventStatus      @default(DRAFT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  budgets        Budget[]
  assignments    EventInventory[]
  tasks          EventTask[]
  supplierJobs   SupplierJob[]
  expenses       Expense[]

  @@index([startsAt, status])
  @@index([clientId, createdAt])
  @@index([organizationId, startsAt])
}

model Budget {
  id                   String                @id
  organizationId       String
  clientId             String
  eventId              String?
  title                String
  status               CommercialStatus      @default(DRAFT)
  subtotal             Int                   @default(0)
  discount             Int                   @default(0)
  total                Int                   @default(0)
  costEstimate         Int                   @default(0)
  validUntil           DateTime?
  notes                String?
  // Plan de pagos (issue #14): anticipo y cuotas visibles en el portal.
  // `installmentsJson` guarda `[{ label, amount, dueAt }]` (dueAt `YYYY-MM-DD`).
  advanceAmount        Int                   @default(0)
  paymentTerms         String?
  installmentsJson     Json?
  // Portal del cliente (issue #12): token público del presupuesto y evidencia
  // de la aprobación digital o manual. El token es la única credencial del
  // link y se puede regenerar o revocar desde el panel.
  publicToken          String?               @unique
  publicTokenCreatedAt DateTime?
  /// Primera vista del link del portal (issue #33): se sella una sola vez, la
  /// primera vez que el cliente abre el presupuesto; los accesos posteriores no
  /// la mueven. Es el hito real de la cronología y nunca se inventa.
  viewedAt             DateTime?
  approvedAt           DateTime?
  approvedByName       String?
  approvalMethod       String?
  approvalIp           String?
  approvalUserAgent    String?
  approvalNote         String?
  revisionRequestedAt  DateTime?
  revisionNote         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client               Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event                Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  items                BudgetItem[]
  payments             ClientPayment[]
  changeRequests       BudgetChangeRequest[]
  paymentProofs        BudgetPaymentProof[]
  /// Pagos esperados del plan (issue #28): anticipo, cuotas y saldo.
  expectedPayments     ExpectedPayment[]

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

model BudgetItem {
  id        String  @id
  budgetId  String
  name      String
  quantity  Int     @default(1)
  days      Int     @default(1)
  unitPrice Int
  costPrice Int     @default(0)
  subtotal  Int
  notes     String?
  /// Vínculo opcional con el inventario (issue #18): al aprobar el presupuesto,
  /// los ítems vinculados reservan stock del evento con el rango del evento.
  /// Sin vínculo el ítem no reserva nada.
  inventoryId String?
  budget    Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  inventory InventoryItem? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([inventoryId])
}

/// Solicitud del cliente desde el portal (issue #14): propuesta de ítems,
/// pedido de rebaja o pedido de cambios (issue #12). El cliente solo ajusta
/// cantidades y días —los precios unitarios son fijos— o propone un descuento;
/// el equipo la acepta (aplicándola al presupuesto) o la rechaza con una nota.
/// `payload` (forma documentada):
///   kind `items`:    `{ items: [{ id, name, quantity, days }] }`
///   kind `discount`: `{ discount: { type: "percent" | "amount", value, amount } }`
///   kind `changes`:  `{ comment: string }`
model BudgetChangeRequest {
  id               String             @id
  organizationId   String
  budgetId         String
  kind             BudgetChangeKind
  status           BudgetChangeStatus @default(pending)
  payload          Json
  note             String?
  requestedByName  String
  requestedByEmail String?
  createdAt        DateTime           @default(now())
  resolvedAt       DateTime?
  resolvedByName   String?
  responseNote     String?
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget           Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([budgetId, createdAt])
}

/**
 * Cobro de cliente: cobrado al momento o a plazo (issue #16).
 * - `status`: `PENDING` (a cobrar), `RECEIVED` (cobrado) o `CANCELLED` (anulado).
 * - `paidAt`: fecha de pago; `null` mientras el cobro está pendiente (un cobro a
 * plazo no es plata cobrada hasta que se marca).
 * - `collectedAt`: fecha real del cobro (los registros viejos usan `paidAt`).
 * - `invoiceIssuedAt`/`invoiceNumber`: factura emitida; `dueAt` es el vencimiento
 * de cobro (la emisión a 30 días se calcula: emisión + días).
 * - `chequeDate`: fecha del cheque cuando el método es cheque.
 */
model ClientPayment {
  id                String               @id
  organizationId    String
  clientId          String
  budgetId          String?
  amount            Int
  status            ClientPaymentStatus  @default(RECEIVED)
  paidAt            DateTime?
  collectedAt       DateTime?
  method            String?
  reference         String?
  invoiceNumber     String?
  invoiceIssuedAt   DateTime?
  dueAt             DateTime?
  chequeDate        DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  /**
   * Snapshot inmutable del cobro al confirmarlo (issue #20): fecha real,
   * monto, método, referencia y los nombres del cliente, presupuesto y cuenta
   * tal como estaban al momento. Si después se renombra el cliente o la cuenta,
   * o se edita el presupuesto, la historia del cobro no cambia.
   */
  collectedSnapshot Json?
  /**
   * Cuenta de tesorería donde entra el cobro (issue #27).
   */
  treasuryAccountId String?
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  budget            Budget?              @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  treasuryAccount   TreasuryAccount?     @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)
  reminders         PaymentReminderLog[]
  proofs            BudgetPaymentProof[]
  /// Pago esperado que se confirmó con este cobro (issue #28); 1:1 opcional.
  expectedPayment   ExpectedPayment?

  @@index([clientId, paidAt])
  @@index([organizationId, paidAt])
  @@index([organizationId, status, dueAt])
  @@index([treasuryAccountId])
}

/**
 * Recordatorio de cobro enviado al cliente (issue #19): una fila por cobro,
 * canal y día de Asunción. El índice único es el candado de idempotencia (un
 * recordatorio por cobro y canal por día, aunque corra el despacho diario y el
 * envío manual a la vez); la corrida diaria sin cron se apoya en él.
 * `sentAt` es el instante del intento y `status` su resultado real; `actorKind`
 * distingue al sistema (`system`) del equipo (`admin`) y la auditoría guarda el
 * actor con nombre y correo.
 */
model PaymentReminderLog {
  id             String                 @id
  organizationId String
  /// Cobro de cliente recordado; `null` cuando el recordatorio es de un pago esperado.
  paymentId      String?
  /// Pago esperado recordado (issue #28); `null` cuando es de un cobro de cliente.
  expectedPaymentId String?
  /**
   * Clave única del destinatario del recordatorio: `client:<paymentId>` o
   * `expected:<expectedPaymentId>`. Es el candado de idempotencia (un
   * recordatorio por destinatario, canal y día) y sobrevive a que `paymentId`
   * sea nulo en los recordatorios de pagos esperados.
   */
  targetKey      String
  channel        PaymentReminderChannel
  status         PaymentReminderStatus  @default(sending)
  to             String
  /** Día de Asunción (`YYYY-MM-DD`) al que pertenece el recordatorio. */
  dayKey         String
  subject        String?
  /** Motivo del fallo, para el historial y la auditoría. */
  error          String?
  actorKind      String                 @default("system")
  actorId        String?
  actorName      String?
  actorEmail     String?
  sentAt         DateTime               @default(now())
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        ClientPayment?         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expectedPayment ExpectedPayment?      @relation(fields: [expectedPaymentId], references: [id], onDelete: SetNull)

  @@unique([targetKey, channel, dayKey])
  @@unique([paymentId, channel, dayKey])
  @@index([organizationId, sentAt])
  @@index([organizationId, dayKey])
  @@index([expectedPaymentId])
}

/**
 * Comprobante de pago subido por el cliente desde el portal (issue #17).
 * El binario vive en `data` (bytea): nunca es público — se sirve únicamente con
 * sesión del panel (`/api/admin/budgets/proofs/[id]`) — y `mime`/`size` guardan
 * el tipo real detectado por magic bytes y el tamaño ya comprimido. El
 * comprobante se cuelga del presupuesto y, cuando hay un único cobro a plazo
 * pendiente, también de ese cobro (`paymentId`); sin cobro queda a nivel del
 * presupuesto para que el equipo lo resuelva al marcar cobrado.
 */
model BudgetPaymentProof {
  id             String         @id
  organizationId String
  budgetId       String
  paymentId      String?
  uploadedByName String
  mime           String
  size           Int
  data           Bytes
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget         Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  payment        ClientPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  /// Pago esperado al que el cliente vinculó este comprobante (issue #28).
  expectedPayment ExpectedPayment?

  @@index([organizationId, budgetId, createdAt])
  @@index([paymentId])
}

enum ExpectedPaymentConcept {
  advance
  installment
  balance
}

/**
 * Estado de un pago esperado (issue #28): `AWAITING` esperando la transferencia,
 * `PROOF` con comprobante del cliente en revisión, `CONFIRMED` confirmado en una
 * cuenta de tesorería y `CANCELLED` cuando el plan dejó de incluir el concepto.
 * Solo la confirmación mueve el dinero: los esperados no cuentan como cobrados.
 */
enum ExpectedPaymentStatus {
  AWAITING
  PROOF
  CONFIRMED
  CANCELLED
}

/**
 * Pago esperado de un presupuesto aprobado (issue #28): el dinero que el plan
 * de pagos promete y que todavía **no** es un cobro. Se genera y sincroniza
 * desde el plan (`advanceAmount` + `installmentsJson` + saldo) al aprobar el
 * presupuesto o al cambiarlo, con una ranura estable por concepto (`slot`:
 * `advance`, `installment:N` o `balance`) que es el candado de idempotencia:
 * repetir la sincronización no duplica ni pisa lo confirmado.
 *
 * - `amount`/`dueAt`/`label` salen del plan; la cuenta destino esperada
 *   (`expectedAccountId`) es de tesorería y se puede cambiar al confirmar.
 * - El comprobante del portal (`proofId`, issue #17) se vincula al subirlo y
 *   deja el pago en `PROOF`; `reviewNote` guarda la observación del equipo, que
 *   el cliente ve en el portal.
 * - Confirmar crea (o cobra) el `ClientPayment` y su `TreasuryMovement` de
 *   entrada en la misma transacción y sella `confirmedAt`/`confirmedBy…`.
 */
model ExpectedPayment {
  id                String               @id
  organizationId    String
  budgetId          String
  concept           ExpectedPaymentConcept
  /// Ranura estable del concepto dentro del plan: `advance`, `installment:N` o `balance`.
  slot              String
  /// Número de cuota (1..n) cuando el concepto es una cuota; `null` en anticipo y saldo.
  installmentNumber Int?
  /** Etiqueta visible del concepto (ej.: «Anticipo», «Cuota 2»). */
  label             String
  amount            Int
  dueAt             DateTime?
  status            ExpectedPaymentStatus @default(AWAITING)
  /// Cuenta de tesorería donde se espera que entre la plata.
  expectedAccountId String?
  /// Comprobante del cliente vinculado (issue #17); 1:1 opcional.
  proofId           String?              @unique
  /// Cobro que confirmó este pago (issue #28); 1:1 opcional.
  paymentId         String?              @unique
  /** Observación del equipo (el cliente ve el motivo en el portal). */
  reviewNote        String?
  reviewedAt        DateTime?
  reviewedByName    String?
  confirmedAt       DateTime?
  confirmedById     String?
  confirmedByName   String?
  confirmedByEmail  String?
  cancelledAt       DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget            Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  expectedAccount   TreasuryAccount?     @relation("ExpectedPaymentAccount", fields: [expectedAccountId], references: [id], onDelete: SetNull)
  proof             BudgetPaymentProof?  @relation(fields: [proofId], references: [id], onDelete: SetNull)
  payment           ClientPayment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reminders         PaymentReminderLog[]

  @@unique([budgetId, slot])
  @@index([organizationId, status, dueAt])
  @@index([budgetId, createdAt])
  @@index([expectedAccountId])
  @@index([proofId])
  @@index([paymentId])
}

model Supplier {
  id             String           @id
  organizationId String
  name           String
  company        String?
  phone          String?
  email          String?
  category       SupplierCategory @default(OTHER)
  paymentTerms   String?
  notes          String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs           SupplierJob[]
  expenses       Expense[]

  @@index([category, active])
  @@index([organizationId, name])
}

model SupplierJob {
  id             String             @id
  organizationId String
  supplierId     String
  eventId        String?
  category       SupplierCategory   @default(OTHER)
  description    String
  total          Int
  advance        Int                @default(0)
  status         SupplierWorkStatus @default(PENDING)
  dueAt          DateTime?
  deliveredAt    DateTime?
  paidAt         DateTime?
  paymentMethod  String?
  receipt        String?
  notes          String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([eventId])
  @@index([organizationId, dueAt])
}

enum TreasuryAccountType {
  CASH
  BANK
  CHEQUE
  OTHER
}

/**
 * Dirección de un movimiento de tesorería: entrada (`IN`), salida (`OUT`) o
 * transferencia entre dos cuentas (`TRANSFER`, con `counterAccountId`).
 */
enum TreasuryMovementDirection {
  IN
  OUT
  TRANSFER
}

/**
 * Hecho que originó un movimiento: cobro de cliente (`client_payment`), pago o
 * anticipo a proveedor (`supplier_job`), gasto (`expense`) o ajuste manual
 * (`adjustment`). Con `sourceId` queda la traza al registro real.
 */
enum TreasuryMovementOrigin {
  client_payment
  supplier_job
  expense
  adjustment
}

/**
 * Categorías de gasto (fuente única: mismo catálogo que el panel).
 */
enum ExpenseCategory {
  TRANSPORT
  FUEL
  FOOD
  MATERIALS
  RENT
  SERVICES
  SALARIES
  TOOLS
  OTHER
}

/**
 * Cuenta de tesorería de la empresa (issue #27): dónde vive la plata —efectivo,
 * banco, cheques a cobrar—. El saldo **nunca** se guarda: se deriva del saldo
 * inicial declarado (`openingBalance`) más los movimientos registrados, que es
 * la única fuente real. `bank` es el nombre del banco para el logo/monograma
 * (`lib/bank-mark.ts`); los cheques no llevan banco y las cuentas se ordenan
 * con `sortOrder`.
 */
model TreasuryAccount {
  id               String              @id
  organizationId   String
  name             String
  type             TreasuryAccountType @default(CASH)
  bank             String?
  currency         String              @default("PYG")
  openingBalance   Int                 @default(0)
  sortOrder        Int                 @default(0)
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements        TreasuryMovement[]  @relation("TreasuryMovementAccount")
  counterMovements TreasuryMovement[]  @relation("TreasuryMovementCounterAccount")
  clientPayments   ClientPayment[]
  expectedPayments ExpectedPayment[]    @relation("ExpectedPaymentAccount")
  expenses         Expense[]

  @@unique([organizationId, name])
  @@index([organizationId, active, sortOrder])
}

/**
 * Movimiento de tesorería (issue #27): la plata que entra, sale o se mueve
 * entre cuentas de la empresa. Se genera desde los hechos reales —cobro de
 * cliente, pago/anticipo a proveedor, gasto— o desde un ajuste manual, y
 * siempre queda auditado. El actor se guarda denormalizado (id + nombre +
 * correo) para que la traza sobreviva a renombres o bajas de cuentas.
 */
model TreasuryMovement {
  id               String                    @id
  organizationId   String
  accountId        String
  /**
   * Cuenta destino de una transferencia; `null` en entradas y salidas.
   */
  counterAccountId String?
  direction        TreasuryMovementDirection
  amount           Int
  /**
   * Fecha real del movimiento (día de Asunción, mediodía).
   */
  occurredAt       DateTime
  origin           TreasuryMovementOrigin    @default(adjustment)
  /**
   * Id del hecho que lo generó (cobro, trabajo de proveedor o gasto).
   */
  sourceId         String?
  /**
   * Snapshot inmutable del hecho que originó el movimiento (issue #20): la
   * etiqueta y los datos que importaban al registrarlo (`{ kind, label, amount,
   * ref }`). La lista de tesorería lee esto y no la fuente viva, así un cambio
   * posterior (cliente renombrado, trabajo editado, gasto borrado) no reescribe
   * la historia. Los movimientos anteriores a la migración caen a la lectura
   * viva de la fuente.
   */
  sourceSnapshot   Json?
  notes            String?
  createdById      String?
  createdByName    String
  createdByEmail   String?
  createdAt        DateTime                  @default(now())
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account          TreasuryAccount           @relation("TreasuryMovementAccount", fields: [accountId], references: [id], onDelete: Cascade)
  counterAccount   TreasuryAccount?          @relation("TreasuryMovementCounterAccount", fields: [counterAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([organizationId, origin, sourceId])
}

/**
 * Gasto de la empresa (issue #27): carga rápida desde el panel y egreso real de
 * una cuenta de tesorería (cada gasto genera su movimiento `OUT`). `eventId`
 * nulo es "A definir" y se asigna después desde la fila; proveedor, método y
 * comprobante son opcionales.
 */
model Expense {
  id             String          @id
  organizationId String
  accountId      String
  eventId        String?
  supplierId     String?
  date           DateTime
  amount         Int
  category       ExpenseCategory @default(OTHER)
  description    String
  method         String?
  receipt        String?
  notes          String?
  createdById    String?
  createdByName  String
  createdByEmail String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        TreasuryAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@index([organizationId, category])
  @@index([organizationId, eventId])
  @@index([accountId, date])
}

model InventoryItem {
  id              String           @id
  organizationId  String
  name            String
  category        String
  sku             String?
  kind            InventoryKind    @default(REUSABLE)
  status          InventoryStatus  @default(AVAILABLE)
  quantity        Int              @default(1)
  replacementCost Int              @default(0)
  dailyCost       Int              @default(0)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments     EventInventory[]
  budgetItems     BudgetItem[]

  @@unique([organizationId, sku])
  @@index([status, category])
  @@index([organizationId, name])
}

model EventInventory {
  id              String        @id
  eventId         String
  inventoryId     String
  quantity        Int           @default(1)
  /// Rango en el que el equipo queda comprometido con el evento. Si falta, se
  /// usa el rango del evento (montaje → desmontaje) para calcular disponibilidad.
  startsAt        DateTime?
  endsAt          DateTime?
  checkedOut      Boolean       @default(false)
  checkedIn       Boolean       @default(false)
  checkedOutAt    DateTime?
  checkedInAt     DateTime?
  conditionOut    String?
  conditionIn     String?
  /// Unidades que volvieron dañadas y unidades que no volvieron, con su detalle.
  damagedQuantity Int           @default(0)
  missingQuantity Int           @default(0)
  damageNotes     String?
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, inventoryId])
  @@index([inventoryId, startsAt, endsAt])
}

model Promoter {
  id                String              @id
  organizationId    String
  name              String
  phone             String?
  email             String?
  photoUrl          String?
  specialties       String?
  active            Boolean             @default(true)
  notes             String?
  /// Disponibilidad declarada (issue #24): default disponible para las existentes.
  availability      PromoterAvailability @default(AVAILABLE)
  availabilityNote  String?
  unavailableUntil  DateTime?
  createdAt         DateTime            @default(now())
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks             EventTask[]

  @@index([active, name])
  @@index([organizationId, name])
  @@index([organizationId, availability])
}

model EventTask {
  id          String        @id
  eventId     String
  promoterId  String?
  type        EventTaskType
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  notes       String?
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoter    Promoter?     @relation(fields: [promoterId], references: [id], onDelete: SetNull)

  @@index([dueAt, completedAt])
}

/// Historial de cambios del panel: quién hizo qué sobre cada registro y con qué
/// valores. El actor se guarda denormalizado (id + nombre + correo) para que la
/// traza sobreviva a renombres o bajas de cuentas; `detail` guarda solo los
/// campos tocados (`changes` con antes/después, `fields` en altas, `before` en bajas).
model AuditLog {
  id             String       @id
  organizationId String
  actorId        String
  actorName      String
  actorEmail     String
  action         String
  entity         String
  entityId       String
  summary        String
  detail         Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([organizationId, actorId])
}

/// Clave de idempotencia de una operación financiera (issue #20).
///
/// La escribe la capa única `lib/server/idempotency.ts` dentro de **la misma
/// transacción** que la operación: las escrituras y el resultado (`status` +
/// `response`) se confirman juntos con la fila. Repetir la misma clave dentro de
/// la empresa devuelve la respuesta original sin tocar los datos, y la misma
/// clave con otro cuerpo responde 409. `requestHash` es el hash del cuerpo
/// normalizado y `expiresAt` el vencimiento que limpia
/// `purgeExpiredIdempotencyKeys`.
model IdempotencyKey {
  id             String       @id
  organizationId String
  /// Operación agrupada: `recurso:método:variante` (por ejemplo `finance:POST:client`).
  scope          String
  /// Clave del cliente (`Idempotency-Key` o `idempotencyKey` del body).
  key            String
  requestHash    String
  /// HTTP status de la respuesta original, guardado junto al resultado.
  status         Int          @default(0)
  response       Json?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, key])
  @@index([expiresAt])
  @@index([organizationId, createdAt])
}

/**
 * Categoría de un correo (issue #30): `reset` (contraseña), `reminder`
 * (recordatorio de cobro), `budget` (presupuesto enviado al cliente), `test`
 * (prueba de configuración) e `invitation` (invitaciones al equipo, cuando
 * lleguen). Es la misma taxonomía del asunto y del historial del panel.
 */
enum MailCategory {
  reset
  reminder
  budget
  test
  invitation
  /// Alerta de operación a OWNER/ADMIN (issue #43): respaldo vencido o fallido.
  alert
}

/** Estado real de un envío: `sending` mientras viaja, `sent` o `failed` (con su motivo). */
enum MailStatus {
  sending
  sent
  failed
}

/**
 * Historial de correos de la app (verificación de envío del panel).
 *
 * Una fila por **intento real** con el proveedor: destinatario, categoría,
 * asunto, estado y el motivo del fallo tal como lo devolvió Resend (o el id del
 * mensaje aceptado). Es la decisión de diseño del issue #31 frente a reutilizar
 * `AuditLog`: la auditoría cuenta *quién hizo qué* con textos recortados, y el
 * historial de correo necesita consultar por estado/categoría/fecha con el error
 * crudo del proveedor. Los registros `skipped` (sin `RESEND_API_KEY` o sin
 * destinatario) no se guardan: no hubo intento.
 *
 * `PaymentReminderLog` sigue siendo la bitácora del recordatorio (un envío por
 * cobro y día, con WhatsApp); `MailLog` es transversal a todos los correos.
 * `organizationId` es opcional: un reset de contraseña de una cuenta sin empresa
 * no pertenece a ninguna empresa y no aparece en su historial.
 */
model MailLog {
  id             String       @id
  organizationId String?
  category       MailCategory
  status         MailStatus   @default(sending)
  to             String
  subject        String
  /// Motivo del fallo devuelto por el proveedor (recortado a 300 caracteres).
  error          String?
  /// Id del mensaje en Resend, para verificar la entrega.
  providerId     String?
  /// Entidad relacionada (por ejemplo `Budget` o `ClientPayment`) y su id.
  entity         String?
  entityId       String?
  actorId        String?
  actorName      String?
  actorEmail     String?
  sentAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([category, createdAt])
}

/**
 * Categoría de una plantilla de mensaje (issue #35): el contexto en el que se
 * usa. `budget` presupuestos · `client` clientes · `event` eventos ·
 * `collection` cobranzas · `other` genéricas.
 */
enum MessageTemplateCategory {
  budget
  client
  event
  collection
  other
}

/**
 * Plantilla de mensaje de WhatsApp por contexto (issue #35).
 *
 * El cuerpo guarda variables `{{...}}` y el render vive en una sola fuente
 * (`lib/server/message-templates.ts`): completa cada variable con datos reales
 * al enviar y **falla claro** si falta un dato, nunca deja un `{{...}}` visible.
 * El índice único (`organizationId`, `category`, `title`) evita duplicados por
 * categoría y es el candado de la provisión de arranque (migración y seed).
 */
model MessageTemplate {
  id             String                  @id
  organizationId String
  category       MessageTemplateCategory
  /// Título corto de la lista (ej.: «Recordatorio de pago»).
  title          String
  /// Cuerpo del mensaje con variables `{{clave}}` (saneado y acotado a 2000).
  body           String
  active         Boolean                 @default(true)
  /// Orden dentro de la categoría (menor primero); los empates caen en `createdAt`.
  sortOrder      Int                     @default(0)
  createdById    String?
  createdByName  String?
  updatedById    String?
  updatedByName  String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, category, title])
  @@index([organizationId, category, sortOrder])
  @@index([organizationId, active])
}
