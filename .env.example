# Public app settings
NEXT_PUBLIC_SITE_URL=https://ledbox.online
NEXT_PUBLIC_ADMIN_URL=https://admin.ledbox.online
# Portal del cliente (issue #12): host público de los presupuestos con QR.
NEXT_PUBLIC_CLIENT_URL=https://clientes.ledbox.online
NEXT_PUBLIC_DEMO_URL=https://demo.ledbox.online
NEXT_PUBLIC_PRODUCT_URL=https://eventos.ledbox.online
NEXT_PUBLIC_APP_URL=https://app.ledbox.online
NEXT_PUBLIC_EVENTOS_URL=https://eventos.ledbox.online
NEXT_PUBLIC_WHATSAPP_NUMBER=595982029217
# Backend settings are provisioned only in Owncoding Hub; never commit real values.
DATABASE_URL=
AUTH_SECRET=
# Google SSO del panel (docs/SSO.md): redirect URI https://admin.ledbox.online/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://ledbox.online
# Empresa que reciben los leads y cotizaciones del sitio público (slug de Organization).
DEFAULT_ORGANIZATION_SLUG=ledbox
RESEND_API_KEY=
EMAIL_FROM=LedBox <ledbox@weem.com.py>
LEDBOX_ADMIN_DARIO_PASSWORD=
LEDBOX_ADMIN_SANTIAGO_PASSWORD=
LEDBOX_ENABLE_ADMIN_REGISTRATION=false
# «Carga con IA» (issue #120): proveedor compatible con chat/completions.
# Sin IA_API_KEY la función queda deshabilitada en el panel.
IA_API_KEY=
# IA_MODELO=deepseek-chat
# IA_BASE_URL=https://api.deepseek.com/v1

# OwnData: sólo backend. URL raíz HTTPS, NO la ruta /api/v1/ruc.
# Sin estas tres variables, la extracción del panel queda indisponible/manual.
# También requiere helpers OwnData publicados en el pin owncoding-ui del panel.
OWNDATA_API_URL=
OWNDATA_API_KEY=
# Ambiente explícito test o live, consistente con clave y respuesta del proveedor.
OWNDATA_ENVIRONMENT=
# Proveedor público legacy (opcional, independiente de la clave OwnData).
RUC_PROVEEDOR_URL=
RUC_PROVEEDOR_TOKEN=
